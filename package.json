{
  "name": "tsundoku-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Find your next read in your owned ebook library.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
